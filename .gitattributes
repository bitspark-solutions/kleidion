# Normalize line endings in the repo; check out as LF everywhere.
* text=auto eol=lf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.lockb binary

# Lockfiles are text but should keep LF
package-lock.json text eol=lf
go.sum text eol=lf
