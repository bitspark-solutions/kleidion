# Dev-only defaults. Copy to .env and adjust; never commit real secrets.
KLEIDION_ENV=development
KLEIDION_PORT=8080
KLEIDION_DB_PASSWORD=kleidion_dev_pw
# For running the server OUTSIDE compose (bare `go run` on host):
KLEIDION_DATABASE_URL=postgres://kleidion:kleidion_dev_pw@localhost:15432/kleidion?sslmode=disable
# openssl rand -hex 32
KLEIDION_SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
NEXT_PUBLIC_API_URL=http://localhost:18080

# Host port mappings (changed from defaults to avoid clashes with other
# local projects: db 15432, api 18080, web 13000, mailpit 18025/11025)
KLEIDION_DB_HOST_PORT=15432
KLEIDION_API_HOST_PORT=18080
KLEIDION_WEB_HOST_PORT=13000
KLEIDION_MAIL_UI_HOST_PORT=18025
KLEIDION_SMTP_HOST_PORT=11025
